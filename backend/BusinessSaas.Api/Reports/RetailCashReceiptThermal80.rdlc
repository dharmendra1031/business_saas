<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <!-- Static, design-time RDLC. Caller supplies InvoiceHeader (1 row), InvoiceLines (N rows)
       from RetailReceiptDataSet.xsd. Visibility uses report parameters only.
       This is a cash RECEIPT, not a GST/tax invoice. -->
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="RetailReceiptSource">
      <ConnectionProperties><DataProvider>System.Data.DataSet</DataProvider><ConnectString>/* Local typed dataset */</ConnectString></ConnectionProperties>
      <rd:DataSourceID>ea9ba86f-44d0-4d6e-8e3c-d759e1ebf2ce</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="InvoiceHeader">
      <Query><DataSourceName>RetailReceiptSource</DataSourceName><CommandText>/* Typed DataSet supplied by caller; no SQL in RDLC */</CommandText></Query>
      <Fields>
        <Field Name="BusinessName"><DataField>BusinessName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ReceiptNumber"><DataField>ReceiptNumber</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="DateText"><DataField>DateText</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="TimeText"><DataField>TimeText</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="CurrencyCode"><DataField>CurrencyCode</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="PaymentMethod"><DataField>PaymentMethod</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="TotalAmount"><DataField>TotalAmount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="CashReceived"><DataField>CashReceived</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="ChangeAmount"><DataField>ChangeAmount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="FooterText"><DataField>FooterText</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="MerchantLegalName"><DataField>MerchantLegalName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="MerchantAddress"><DataField>MerchantAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="MerchantPhone"><DataField>MerchantPhone</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="MerchantEmail"><DataField>MerchantEmail</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="CustomerName"><DataField>CustomerName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="CustomerPhone"><DataField>CustomerPhone</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="CustomerAddress"><DataField>CustomerAddress</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="LocationName"><DataField>LocationName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="MerchantLogo"><DataField>MerchantLogo</DataField><rd:TypeName>System.Byte[]</rd:TypeName></Field>
      </Fields>
    </DataSet>
    <DataSet Name="InvoiceLines">
      <Query><DataSourceName>RetailReceiptSource</DataSourceName><CommandText>/* Typed DataSet supplied by caller; no SQL in RDLC */</CommandText></Query>
      <Fields>
        <Field Name="LineNumber"><DataField>LineNumber</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="ProductName"><DataField>ProductName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Quantity"><DataField>Quantity</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="UnitPrice"><DataField>UnitPrice</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="LineTotal"><DataField>LineTotal</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="ProductSku"><DataField>ProductSku</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="UnitCode"><DataField>UnitCode</DataField><rd:TypeName>System.String</rd:TypeName></Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportSections><ReportSection><Body>
    <ReportItems>
      <Tablix Name="ReceiptTable">
        <TablixBody>
          <TablixColumns><TablixColumn><Width>1.95in</Width></TablixColumn><TablixColumn><Width>0.91in</Width></TablixColumn></TablixColumns>
          <TablixRows>
          <TablixRow><Height>0.48in</Height><TablixCells>
            <TablixCell><CellContents><Image Name="CompanyLogo"><Source>Database</Source><Value>=First(Fields!MerchantLogo.Value, &quot;InvoiceHeader&quot;)</Value><MIMEType>image/png</MIMEType><Sizing>FitProportional</Sizing><Style><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Image><ColSpan>2</ColSpan></CellContents></TablixCell>
            <TablixCell />
          </TablixCells></TablixRow>
          <TablixRow><Height>0.25in</Height><TablixCells>
            <TablixCell><CellContents><Textbox Name="BrandName"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!BusinessName.Value, &quot;InvoiceHeader&quot;)</Value><Style><FontFamily>Arial</FontFamily><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><Color>#000000</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>BrandName</rd:DefaultName><Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><ColSpan>2</ColSpan></CellContents></TablixCell>
            <TablixCell />
          </TablixCells></TablixRow>
          <TablixRow><Height>0.18in</Height><TablixCells>
            <TablixCell><CellContents><Textbox Name="MerchantLegalName"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!MerchantLegalName.Value, &quot;InvoiceHeader&quot;)</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><Color>#000000</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>MerchantLegalName</rd:DefaultName><Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><ColSpan>2</ColSpan></CellContents></TablixCell>
            <TablixCell />
          </TablixCells></TablixRow>
          <TablixRow><Height>0.18in</Height><TablixCells>
            <TablixCell><CellContents><Textbox Name="MerchantAddress"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!MerchantAddress.Value, &quot;InvoiceHeader&quot;)</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><Color>#000000</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>MerchantAddress</rd:DefaultName><Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><ColSpan>2</ColSpan></CellContents></TablixCell>
            <TablixCell />
          </TablixCells></TablixRow>
          <TablixRow><Height>0.18in</Height><TablixCells>
            <TablixCell><CellContents><Textbox Name="MerchantPhone"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!MerchantPhone.Value, &quot;InvoiceHeader&quot;)</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><Color>#000000</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>MerchantPhone</rd:DefaultName><Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><ColSpan>2</ColSpan></CellContents></TablixCell>
            <TablixCell />
          </TablixCells></TablixRow>
          <TablixRow><Height>0.18in</Height><TablixCells>
            <TablixCell><CellContents><Textbox Name="MerchantEmail"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!MerchantEmail.Value, &quot;InvoiceHeader&quot;)</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><Color>#000000</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>MerchantEmail</rd:DefaultName><Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><ColSpan>2</ColSpan></CellContents></TablixCell>
            <TablixCell />
          </TablixCells></TablixRow>
          <TablixRow><Height>0.18in</Height><TablixCells>
            <TablixCell><CellContents><Textbox Name="BranchName"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!LocationName.Value, &quot;InvoiceHeader&quot;)</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><Color>#000000</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>BranchName</rd:DefaultName><Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><ColSpan>2</ColSpan></CellContents></TablixCell>
            <TablixCell />
          </TablixCells></TablixRow>
          <TablixRow><Height>0.19in</Height><TablixCells>
            <TablixCell><CellContents><Textbox Name="ReceiptTitle"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!PaymentMethod.Value, &quot;InvoiceHeader&quot;) &amp; &quot; RECEIPT&quot;</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#000000</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>ReceiptTitle</rd:DefaultName><Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><ColSpan>2</ColSpan></CellContents></TablixCell>
            <TablixCell />
          </TablixCells></TablixRow>
          <TablixRow><Height>0.18in</Height><TablixCells>
            <TablixCell><CellContents><Textbox Name="ReceiptId"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=&quot;Receipt #&quot; &amp; First(Fields!ReceiptNumber.Value, &quot;InvoiceHeader&quot;)</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><Color>#000000</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>ReceiptId</rd:DefaultName><Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><ColSpan>2</ColSpan></CellContents></TablixCell>
            <TablixCell />
          </TablixCells></TablixRow>
          <TablixRow><Height>0.18in</Height><TablixCells>
            <TablixCell><CellContents><Textbox Name="ReceiptDate"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!DateText.Value, &quot;InvoiceHeader&quot;) &amp; IIf(Parameters!ShowTime.Value, &quot; &quot; &amp; First(Fields!TimeText.Value, &quot;InvoiceHeader&quot;), &quot;&quot;)</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><Color>#000000</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>ReceiptDate</rd:DefaultName><Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><ColSpan>2</ColSpan></CellContents></TablixCell>
            <TablixCell />
          </TablixCells></TablixRow>
          <TablixRow><Height>0.18in</Height><TablixCells>
            <TablixCell><CellContents><Textbox Name="CustomerName"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=&quot;Customer name: &quot; &amp; First(Fields!CustomerName.Value, &quot;InvoiceHeader&quot;)</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><Color>#000000</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>CustomerName</rd:DefaultName><Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><ColSpan>2</ColSpan></CellContents></TablixCell>
            <TablixCell />
          </TablixCells></TablixRow>
          <TablixRow><Height>0.18in</Height><TablixCells>
            <TablixCell><CellContents><Textbox Name="CustomerPhone"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=&quot;Customer phone: &quot; &amp; First(Fields!CustomerPhone.Value, &quot;InvoiceHeader&quot;)</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><Color>#000000</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>CustomerPhone</rd:DefaultName><Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><ColSpan>2</ColSpan></CellContents></TablixCell>
            <TablixCell />
          </TablixCells></TablixRow>
          <TablixRow><Height>0.18in</Height><TablixCells>
            <TablixCell><CellContents><Textbox Name="CustomerAddress"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=&quot;Customer address: &quot; &amp; First(Fields!CustomerAddress.Value, &quot;InvoiceHeader&quot;)</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><Color>#000000</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>CustomerAddress</rd:DefaultName><Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><ColSpan>2</ColSpan></CellContents></TablixCell>
            <TablixCell />
          </TablixCells></TablixRow>
          <TablixRow><Height>0.19in</Height><TablixCells>
            <TablixCell><CellContents><Textbox Name="ItemHeading"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>ITEM / QTY</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#000000</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>ItemHeading</rd:DefaultName><Style><BottomBorder><Style>Solid</Style><Color>#000000</Color></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="AmountHeading"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>AMOUNT</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#000000</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>AmountHeading</rd:DefaultName><Style><BottomBorder><Style>Solid</Style><Color>#000000</Color></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell>
          </TablixCells></TablixRow>
          <TablixRow><Height>0.31in</Height><TablixCells>
            <TablixCell><CellContents><Textbox Name="ProductDescription"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!LineNumber.Value &amp; &quot;. &quot; &amp; Fields!ProductName.Value &amp; IIf(Parameters!ShowSku.Value And Len(Fields!ProductSku.Value) &gt; 0, vbCrLf &amp; &quot;SKU: &quot; &amp; Fields!ProductSku.Value, &quot;&quot;) &amp; vbCrLf &amp; Format(Fields!Quantity.Value, &quot;0.###&quot;) &amp; IIf(Parameters!ShowUnit.Value And Len(Fields!UnitCode.Value) &gt; 0, &quot; &quot; &amp; Fields!UnitCode.Value, &quot;&quot;) &amp; IIf(Parameters!ShowUnitPrice.Value, &quot; @ &quot; &amp; Format(Fields!UnitPrice.Value, &quot;0.00&quot;), &quot;&quot;)</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><Color>#000000</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>ProductDescription</rd:DefaultName><Style><BottomBorder><Style>Solid</Style><Color>#000000</Color></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="LineAmount"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!CurrencyCode.Value, &quot;InvoiceHeader&quot;) &amp; &quot; &quot; &amp; Format(Fields!LineTotal.Value, &quot;0.00&quot;)</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><Color>#000000</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>LineAmount</rd:DefaultName><Style><BottomBorder><Style>Solid</Style><Color>#000000</Color></BottomBorder><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell>
          </TablixCells></TablixRow>
          <TablixRow><Height>0.25in</Height><TablixCells>
            <TablixCell><CellContents><Textbox Name="TotalLabel"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>TOTAL PAYABLE</Value><Style><FontFamily>Arial</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#000000</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>TotalLabel</rd:DefaultName><Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="TotalValue"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!CurrencyCode.Value, &quot;InvoiceHeader&quot;) &amp; &quot; &quot; &amp; Format(First(Fields!TotalAmount.Value, &quot;InvoiceHeader&quot;), &quot;0.00&quot;)</Value><Style><FontFamily>Arial</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#000000</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>TotalValue</rd:DefaultName><Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell>
          </TablixCells></TablixRow>
          <TablixRow><Height>0.18in</Height><TablixCells>
            <TablixCell><CellContents><Textbox Name="TenderLabel"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Cash received</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><Color>#000000</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>TenderLabel</rd:DefaultName><Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="TenderValue"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!CurrencyCode.Value, &quot;InvoiceHeader&quot;) &amp; &quot; &quot; &amp; Format(First(Fields!CashReceived.Value, &quot;InvoiceHeader&quot;), &quot;0.00&quot;)</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><Color>#000000</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>TenderValue</rd:DefaultName><Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell>
          </TablixCells></TablixRow>
          <TablixRow><Height>0.18in</Height><TablixCells>
            <TablixCell><CellContents><Textbox Name="ChangeLabel"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>Change</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><Color>#000000</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>ChangeLabel</rd:DefaultName><Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="ChangeValue"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!CurrencyCode.Value, &quot;InvoiceHeader&quot;) &amp; &quot; &quot; &amp; Format(First(Fields!ChangeAmount.Value, &quot;InvoiceHeader&quot;), &quot;0.00&quot;)</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><Color>#000000</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>ChangeValue</rd:DefaultName><Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox></CellContents></TablixCell>
          </TablixCells></TablixRow>
          <TablixRow><Height>0.18in</Height><TablixCells>
            <TablixCell><CellContents><Textbox Name="FooterLabel"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!FooterText.Value, &quot;InvoiceHeader&quot;)</Value><Style><FontFamily>Arial</FontFamily><FontSize>8.5pt</FontSize><Color>#000000</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><rd:DefaultName>FooterLabel</rd:DefaultName><Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>1pt</PaddingTop><PaddingBottom>1pt</PaddingBottom></Style></Textbox><ColSpan>2</ColSpan></CellContents></TablixCell>
            <TablixCell />
          </TablixCells></TablixRow>
          </TablixRows>
        </TablixBody>
        <TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy>
        <TablixRowHierarchy><TablixMembers>
<TablixMember><Visibility><Hidden>=Not(Parameters!ShowLogo.Value) Or IsNothing(First(Fields!MerchantLogo.Value, &quot;InvoiceHeader&quot;))</Hidden></Visibility><KeepWithGroup>After</KeepWithGroup><RepeatOnNewPage>true</RepeatOnNewPage></TablixMember>
<TablixMember><KeepWithGroup>After</KeepWithGroup><RepeatOnNewPage>true</RepeatOnNewPage></TablixMember>
<TablixMember><Visibility><Hidden>=Not(Parameters!ShowLegalName.Value) Or Len(First(Fields!MerchantLegalName.Value, &quot;InvoiceHeader&quot;)) = 0</Hidden></Visibility><KeepWithGroup>After</KeepWithGroup><RepeatOnNewPage>true</RepeatOnNewPage></TablixMember>
<TablixMember><Visibility><Hidden>=Not(Parameters!ShowAddress.Value) Or Len(First(Fields!MerchantAddress.Value, &quot;InvoiceHeader&quot;)) = 0</Hidden></Visibility><KeepWithGroup>After</KeepWithGroup><RepeatOnNewPage>true</RepeatOnNewPage></TablixMember>
<TablixMember><Visibility><Hidden>=Not(Parameters!ShowPhone.Value) Or Len(First(Fields!MerchantPhone.Value, &quot;InvoiceHeader&quot;)) = 0</Hidden></Visibility><KeepWithGroup>After</KeepWithGroup><RepeatOnNewPage>true</RepeatOnNewPage></TablixMember>
