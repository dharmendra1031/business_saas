<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <!-- Static, design-time RDLC. Caller supplies InvoiceHeader (1 row), InvoiceLines (N rows)
       from RetailReceiptDataSet.xsd. Visibility uses report parameters only.
       This is a cash RECEIPT, not a GST/tax invoice. -->
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="RetailReceiptSource">
      <ConnectionProperties><DataProvider>System.Data.DataSet</DataProvider><ConnectString>/* Local typed dataset */</ConnectString></ConnectionProperties>
      <rd:DataSourceID>ea9ba86f-44d0-4d6e-8e3c-d759e1ebf2ce</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="InvoiceHeader">
      <Query><DataSourceName>RetailReceiptSource</DataSourceName><CommandText>/* Typed DataSet supplied by caller; no SQL in RDLC */</CommandText></Query>
      <Fields>
        <Field Name="BusinessName"><DataField>BusinessName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ReceiptNumber"><DataField>ReceiptNumber</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="DateText"><DataField>DateText</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="TimeText"><DataField>TimeText</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="CurrencyCode"><DataField>CurrencyCode</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="PaymentMethod"><DataField>PaymentMethod</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="TotalAmount"><DataField>TotalAmount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="CashReceived"><DataField>CashReceived</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="ChangeAmount"><DataField>ChangeAmount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="FooterText"><DataField>FooterText</DataField><rd:TypeName>System.String</rd:TypeName></Field>
      </Fields>
    </DataSet>
    <DataSet Name="InvoiceLines">
      <Query><DataSourceName>RetailReceiptSource</DataSourceName><CommandText>/* Typed DataSet supplied by caller; no SQL in RDLC */</CommandText></Query>
      <Fields>
        <Field Name="LineNumber"><DataField>LineNumber</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="ProductName"><DataField>ProductName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Quantity"><DataField>Quantity</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="UnitPrice"><DataField>UnitPrice</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="LineTotal"><DataField>LineTotal</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportSections><ReportSection><Body>
    <ReportItems>
      <Tablix Name="ReceiptTable">
        <TablixBody>
          <TablixColumns><TablixColumn><Width>1.95in</Width></TablixColumn><TablixColumn><Width>0.91in</Width></TablixColumn></TablixColumns>
          <TablixRows>
          <TablixRow><Height>.36in</Height><TablixCells><TablixCell><CellContents><Textbox Name="BrandName"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
    <Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!BusinessName.Value, &quot;InvoiceHeader&quot;)</Value><Style><FontFamily>Arial</FontFamily><FontSize>11pt</FontSize><FontWeight>Bold</FontWeight><Color>#111111</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
    <rd:DefaultName>BrandName</rd:DefaultName><Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="ReceiptTitle"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
    <Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!PaymentMethod.Value, &quot;InvoiceHeader&quot;) &amp; &quot; RECEIPT&quot;</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#233B58</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
    <rd:DefaultName>ReceiptTitle</rd:DefaultName><Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
          <TablixRow><Height>.32in</Height><TablixCells><TablixCell><CellContents><Textbox Name="ReceiptId"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
    <Paragraphs><Paragraph><TextRuns><TextRun><Value>=&quot;Receipt #&quot; &amp; First(Fields!ReceiptNumber.Value, &quot;InvoiceHeader&quot;)</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><Color>#111111</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
    <rd:DefaultName>ReceiptId</rd:DefaultName><Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="ReceiptDate"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
    <Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!DateText.Value, &quot;InvoiceHeader&quot;) &amp; IIf(Parameters!ShowTime.Value, &quot; &quot; &amp; First(Fields!TimeText.Value, &quot;InvoiceHeader&quot;), &quot;&quot;)</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><Color>#111111</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
    <rd:DefaultName>ReceiptDate</rd:DefaultName><Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
          <TablixRow><Height>.27in</Height><TablixCells><TablixCell><CellContents><Textbox Name="ItemHeading"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
    <Paragraphs><Paragraph><TextRuns><TextRun><Value>ITEM / QTY</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#111111</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
    <rd:DefaultName>ItemHeading</rd:DefaultName><Style><BackgroundColor>#EBF0F6</BackgroundColor><Border><Bottom><Style>Solid</Style><Color>#C8D1DC</Color></Bottom></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="AmountHeading"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
    <Paragraphs><Paragraph><TextRuns><TextRun><Value>AMOUNT</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#111111</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
    <rd:DefaultName>AmountHeading</rd:DefaultName><Style><BackgroundColor>#EBF0F6</BackgroundColor><Border><Bottom><Style>Solid</Style><Color>#C8D1DC</Color></Bottom></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
          <TablixRow><Height>.30in</Height><TablixCells><TablixCell><CellContents><Textbox Name="ProductDescription"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
    <Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Fields!LineNumber.Value, &quot;0&quot;) &amp; &quot;. &quot; &amp; Fields!ProductName.Value &amp; &quot;  x &quot; &amp; Format(Fields!Quantity.Value, &quot;0.###&quot;) &amp; IIf(Parameters!ShowUnitPrice.Value, &quot;  @ &quot; &amp; Format(Fields!UnitPrice.Value, &quot;0.00&quot;), &quot;&quot;)</Value><Style><FontFamily>Arial</FontFamily><FontSize>9pt</FontSize><Color>#111111</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
    <rd:DefaultName>ProductDescription</rd:DefaultName><Style><Border><Bottom><Style>Solid</Style><Color>#C8D1DC</Color></Bottom></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="LineAmount"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
    <Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!CurrencyCode.Value, &quot;InvoiceHeader&quot;) &amp; &quot; &quot; &amp; Format(Fields!LineTotal.Value, &quot;0.00&quot;)</Value><Style><FontFamily>Arial</FontFamily><FontSize>9pt</FontSize><Color>#111111</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
    <rd:DefaultName>LineAmount</rd:DefaultName><Style><Border><Bottom><Style>Solid</Style><Color>#C8D1DC</Color></Bottom></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
          <TablixRow><Height>.37in</Height><TablixCells><TablixCell><CellContents><Textbox Name="TotalLabel"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
    <Paragraphs><Paragraph><TextRuns><TextRun><Value>TOTAL PAYABLE</Value><Style><FontFamily>Arial</FontFamily><FontSize>11pt</FontSize><FontWeight>Bold</FontWeight><Color>#111111</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
    <rd:DefaultName>TotalLabel</rd:DefaultName><Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="TotalValue"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
    <Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!CurrencyCode.Value, &quot;InvoiceHeader&quot;) &amp; &quot; &quot; &amp; Format(First(Fields!TotalAmount.Value, &quot;InvoiceHeader&quot;), &quot;0.00&quot;)</Value><Style><FontFamily>Arial</FontFamily><FontSize>11pt</FontSize><FontWeight>Bold</FontWeight><Color>#111111</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
    <rd:DefaultName>TotalValue</rd:DefaultName><Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
          <TablixRow><Height>.28in</Height><TablixCells><TablixCell><CellContents><Textbox Name="TenderLabel"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
    <Paragraphs><Paragraph><TextRuns><TextRun><Value>CASH RECEIVED</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><Color>#111111</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
    <rd:DefaultName>TenderLabel</rd:DefaultName><Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="TenderValue"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
    <Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!CurrencyCode.Value, &quot;InvoiceHeader&quot;) &amp; &quot; &quot; &amp; Format(First(Fields!CashReceived.Value, &quot;InvoiceHeader&quot;), &quot;0.00&quot;)</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><Color>#111111</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
    <rd:DefaultName>TenderValue</rd:DefaultName><Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
          <TablixRow><Height>.28in</Height><TablixCells><TablixCell><CellContents><Textbox Name="ChangeLabel"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
    <Paragraphs><Paragraph><TextRuns><TextRun><Value>CHANGE</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><Color>#111111</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
    <rd:DefaultName>ChangeLabel</rd:DefaultName><Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="ChangeValue"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
    <Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!CurrencyCode.Value, &quot;InvoiceHeader&quot;) &amp; &quot; &quot; &amp; Format(First(Fields!ChangeAmount.Value, &quot;InvoiceHeader&quot;), &quot;0.00&quot;)</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><Color>#111111</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
    <rd:DefaultName>ChangeValue</rd:DefaultName><Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell></TablixCells></TablixRow>
          <TablixRow><Height>.42in</Height><TablixCells><TablixCell><CellContents><Textbox Name="FooterLabel"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
    <Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!FooterText.Value, &quot;InvoiceHeader&quot;)</Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><Color>#39495D</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
    <rd:DefaultName>FooterLabel</rd:DefaultName><Style><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style></Textbox></CellContents></TablixCell><TablixCell><CellContents><Textbox Name="FooterBlank"><CanGrow>true</CanGrow><KeepTogether>true</KeepTogether>
    <Paragraphs><Paragraph><TextRuns><TextRun><Value></Value><Style><FontFamily>Arial</FontFamily><FontSize>7.5pt</FontSize><Color>#111111</Color></Style></TextRun></TextRuns><Style><TextAlign>Left</TextAlign></Style></Paragraph></Paragraphs>
